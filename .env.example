NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:5000
NEXTAUTH_URL=http://localhost:3000
# Generate a local secret with the backend scripts/init-local-env.mjs helper.
NEXTAUTH_SECRET=

# Server-only OAuth web client credentials. Never prefix the secret with NEXT_PUBLIC_.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Google redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
